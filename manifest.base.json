{
  "manifest_version": 3,
  "name": "SubBridge",
  "version": "3.0.0",
  "description": "Translate the subtitles web videos already have (Google, Gemini, OpenRouter, NVIDIA) and play .ass/.srt subtitles on any video.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "i18n-content.js",
        "content.js",
        "scripts.js",
        "parsers.js",
        "grabber.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "hook-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}